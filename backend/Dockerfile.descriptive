FROM public.ecr.aws/lambda/python:3.12
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv export --only-group backend-descriptive --no-hashes --no-emit-project -o req.txt \
   && uv pip install --system --no-cache -r req.txt

COPY backend ${LAMBDA_TASK_ROOT}/backend
COPY sql/queries ${LAMBDA_TASK_ROOT}/sql/queries

CMD ["backend.app.descriptive_main.handler"]